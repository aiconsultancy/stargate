{
  "dataDirectory": ".stargate",
  "api": { "listen": "127.0.0.1:8484" },
  "notify": {
    "adapters": {
      "local-http": {
        "type": "http",
        "enabled": false,
        "path": "/v1/notifications/local",
        "sources": [
          {
            "id": "release-ci",
            "tokenEnv": "STARGATE_NOTIFY_RELEASE_CI",
            "topics": ["release.*"],
            "audience": "internal",
            "perMinute": 60
          }
        ]
      }
    },
    "destinations": {
      "release-log": {
        "slack": { "bot": "code-helper", "channel": "C123" },
        "audience": "internal"
      }
    },
    "subscriptions": [{ "topic": "release.*", "to": ["release-log"] }]
  },
  "subspaceAgents": {
    "enabled": false,
    "api": { "baseUrl": "https://subspace.internal.example" },
    "enrolment": { "tokenFile": "/etc/stargate/subspace-enrolment-token" },
    "officers": [
      {
        "name": "example-captain",
        "rank": "captain",
        "ship": "example-ship",
        "model": "example-model",
        "ircNick": "example-captain",
        "socketPath": "/run/stargate/subspace/example-captain/api.sock"
      }
    ]
  },
  "agentDispatch": {
    "enabled": false,
    "fleet": "example-fleet",
    "api": {
      "baseUrl": "https://subspace.internal.example",
      "tokenEnv": "STARGATE_SUBSPACE_DISPATCH_TOKEN",
      "headersEnv": {}
    },
    "messaging": { "type": "irc", "registration": "fleet-admiral" },
    "pollIntervalSeconds": 120,
    "answerTimeoutSeconds": 300,
    "retryLadderSeconds": [3600, 10800, 21600, 43200]
  },
  "bots": [
    {
      "id": "code-helper",
      "displayName": "Code Helper",
      "threadContext": false,
      "waiting": { "delayMs": 5000, "intervalMs": 10000 },
      "slack": {
        "appId": "A123",
        "appTokenEnv": "STARGATE_CODE_APP_TOKEN",
        "botTokenEnv": "STARGATE_CODE_BOT_TOKEN"
      },
      "access": { "users": ["U123"], "channels": ["C123"] },
      "backend": {
        "type": "opencode",
        "url": "http://localhost:4096",
        "directory": "/srv/project",
        "permissions": [{ "action": "*", "resource": "*", "effect": "deny" }]
      }
    },
    {
      "id": "pi-helper",
      "slack": {
        "appId": "A456",
        "appTokenEnv": "STARGATE_PI_APP_TOKEN",
        "botTokenEnv": "STARGATE_PI_BOT_TOKEN"
      },
      "access": { "users": ["U123"], "channels": ["C123"] },
      "backend": {
        "type": "pi-durable",
        "directory": "/srv/project",
        "model": "openai/gpt-5",
        "tools": "none"
      }
    }
  ]
}
