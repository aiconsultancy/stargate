{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai-proxy/gpt-6.1-sol",
  "default_agent": "bowser",
  "permissions": [{ "action": "*", "resource": "*", "effect": "deny" }],
  "compaction": {
    "auto": true,
    "buffer": "20%",
    "keep": { "tokens": 15000 }
  },
  "experimental": { "background_compaction": true, "subagent_depth": 1 },
  "providers": {
    "openai-proxy": {
      "name": "OpenAI Proxy",
      "package": "@opencode/ai/providers/openai-compatible/responses",
      "settings": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "{env:CLIPROXYAPI_API_KEY}",
        "encoding": "none",
        "transport": "http"
      },
      "models": {
        "gpt-6.1-sol": { "name": "GPT-6.1 Sol (subscription)" },
        "gpt-6.1-terra": { "name": "GPT-6.1 Terra (subscription)" },
        "gpt-6-luna": { "name": "GPT-6 Luna (subscription)" }
      }
    },
    "claude-proxy": {
      "name": "Claude Proxy",
      "package": "@opencode/ai/providers/anthropic-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "{env:CLIPROXYAPI_API_KEY}"
      },
      "models": {
        "claude-sonnet-5-5": { "name": "Claude Sonnet 5.5 (subscription)" },
        "claude-opus-5-5": { "name": "Claude Opus 5.5 (subscription)" },
        "claude-fable-5-1": { "name": "Claude Fable 5.1 (subscription)" }
      }
    },
    "go-proxy": {
      "name": "OpenCode Go Proxy",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "{env:CLIPROXYAPI_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "modelID": "opencode-go/deepseek-v4.1-flash",
          "capabilities": { "tools": true, "reasoning": { "supported": true } },
          "compatibility": { "reasoningField": "reasoning_content" },
          "limit": { "context": 1000000, "output": 384000 }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "modelID": "opencode-go/deepseek-v4-pro",
          "capabilities": { "tools": true, "reasoning": { "supported": true } },
          "compatibility": { "reasoningField": "reasoning_content" },
          "limit": { "context": 1000000, "output": 384000 }
        },
        "glm-5.3-flash": {
          "name": "GLM-5.3-Flash",
          "modelID": "opencode-go/glm-5.3-flash",
          "capabilities": { "tools": true, "reasoning": { "supported": true } },
          "compatibility": { "reasoningField": "reasoning_content" },
          "limit": { "context": 1000000, "output": 131072 }
        },
        "glm-5.3": {
          "name": "GLM-5.3",
          "modelID": "opencode-go/glm-5.3",
          "capabilities": { "tools": true, "reasoning": { "supported": true } },
          "compatibility": { "reasoningField": "reasoning_content" },
          "limit": { "context": 1000000, "output": 131072 }
        },
        "kimi-k3": {
          "name": "Kimi K3",
          "modelID": "opencode-go/kimi-k3",
          "capabilities": { "tools": true, "reasoning": { "supported": true } },
          "compatibility": { "reasoningField": "reasoning_content" },
          "limit": { "context": 1048576, "output": 131072 }
        },
        "qwen3.8-max": {
          "name": "Qwen3.8 Max",
          "modelID": "opencode-go/qwen3.8-max",
          "capabilities": { "tools": true, "reasoning": { "supported": true } },
          "limit": { "context": 1000000, "output": 131072 }
        }
      }
    }
  }
}
