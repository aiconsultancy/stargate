{
  "name": "stargate",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiconsultancy/stargate.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/crew/plugin.ts"
  },
  "bin": {
    "stargate": "./src/main.ts"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "start": "bun run src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write --error-on-warnings .",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.326",
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@openai/codex-sdk": "0.169.0",
    "@opencode/client": "2.3.2",
    "@opencode/plugin": "2.3.2",
    "@opencode/schema": "2.3.2",
    "@slack/socket-mode": "^3.2.0",
    "@slack/web-api": "^8.4.0",
    "croner": "^11.0.1",
    "effect": "4.1.0",
    "jose": "6.2.17",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@hona/strobe": "0.44.0",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
