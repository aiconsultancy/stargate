{
  "name": "pogo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/crew/plugin.ts"
  },
  "bin": {
    "pogo": "./src/main.ts"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "start": "bun run src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write --error-on-warnings .",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.323",
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@opencode/client": "^2.2.7",
    "@opencode/plugin": "2.2.7",
    "@opencode/schema": "2.2.7",
    "@slack/socket-mode": "^3.2.0",
    "@slack/web-api": "^8.3.0",
    "croner": "^11.0.0",
    "effect": "4.1.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
