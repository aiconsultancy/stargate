{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".cursor/**",
    ".git/**",
    ".opencode/**",
    "node_modules/**",
    "tools/oxlint/**"
  ],
  "rules": {
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/switch-exhaustiveness-check": [
      "error",
      {
        "considerDefaultExhaustiveForUnions": true
      }
    ],
    "typescript/no-this-alias": "off",
    "eslint/no-misleading-character-class": "off",
    "unicorn/no-useless-spread": "off",
    "unicorn/no-useless-fallback-in-spread": "off",
    "unicorn/prefer-string-starts-ends-with": "off",
    "typescript/await-thenable": "off",
    "typescript/unbound-method": "off",
    "typescript/no-misused-spread": "off",
    "typescript/no-base-to-string": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/require-array-sort-compare": "off",
    "typescript/no-unsafe-return": "off"
  },
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    }
  ],
  "overrides": [
    {
      "files": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "scripts/**/*.ts",
        "perf/**/*.ts"
      ],
      "excludeFiles": [
        "scripts/bootstrap-stargate.ts",
        "scripts/migrate-stargate-state.ts",
        "src/app/status-report.ts",
        "src/config/settings-legacy.ts",
        "src/crew/input/project-options.ts",
        "src/crew/input/tool-input.ts",
        "src/crew/pi/pi-extension.ts",
        "src/crew/reporting/fleet-status.ts",
        "src/cron/control.ts",
        "src/cron/input.ts",
        "src/cron/job-files.ts",
        "src/cron/store.ts",
        "src/cron/ui.ts",
        "src/dashboard/api/v1/config.ts",
        "src/health/health-host.ts",
        "src/health/health.ts",
        "src/maintenance/maintenance.ts",
        "src/maintenance/nightly/cleanup/cleanup-config.ts",
        "src/maintenance/nightly/cli.ts",
        "src/maintenance/nightly/crews.ts",
        "src/maintenance/nightly/droid/droid-agent.ts",
        "src/maintenance/nightly/droid/droid-facts.ts",
        "src/maintenance/nightly/droid/droid.ts",
        "src/maintenance/nightly/journal.ts",
        "src/maintenance/nightly/reports/report.ts",
        "src/maintenance/nightly/run.ts",
        "src/maintenance/nightly/state.ts",
        "src/maintenance/nightly/update/cooloff.ts",
        "src/maintenance/nightly/update/host.ts",
        "src/maintenance/nightly/update/plugin-digest.ts",
        "src/maintenance/nightly/update/ready.ts",
        "src/maintenance/nightly/update/release.ts",
        "src/maintenance/update-notice.ts",
        "src/notifications/preferences/notification-store.ts",
        "src/notifications/preferences/notifications.ts",
        "src/ops/agent-profile-switch.ts",
        "src/quota/quota-watch.ts",
        "src/quota/quota.ts",
        "src/shared/crew-status.ts"
      ],
      "rules": {
        "anti-slop/no-module-mocking": "error",
        "anti-slop/no-reduce-accumulator-copy": "error",
        "anti-slop/no-widen-then-assert": "error",
        "eslint/array-callback-return": "error",
        "eslint/block-scoped-var": "error",
        "eslint/default-case-last": "error",
        "eslint/default-param-last": "error",
        "eslint/func-name-matching": "error",
        "eslint/grouped-accessor-pairs": "error",
        "eslint/guard-for-in": "error",
        "eslint/id-denylist": "error",
        "eslint/id-match": "error",
        "eslint/logical-assignment-operators": "error",
        "eslint/max-nested-callbacks": "error",
        "eslint/no-alert": "error",
        "eslint/no-array-constructor": "error",
        "eslint/no-case-declarations": "error",
        "eslint/no-constructor-return": "error",
        "eslint/no-div-regex": "error",
        "eslint/no-else-return": "error",
        "eslint/no-extend-native": "error",
        "eslint/no-extra-bind": "error",
        "eslint/no-extra-label": "error",
        "eslint/no-fallthrough": "error",
        "eslint/no-implicit-globals": "error",
        "eslint/no-implied-eval": "error",
        "eslint/no-label-var": "error",
        "eslint/no-labels": "error",
        "eslint/no-lone-blocks": "error",
        "eslint/no-lonely-if": "error",
        "eslint/no-multi-assign": "error",
        "eslint/no-multi-str": "error",
        "eslint/no-new-func": "error",
        "eslint/no-new-wrappers": "error",
        "eslint/no-object-constructor": "error",
        "eslint/no-proto": "error",
        "eslint/no-prototype-builtins": "error",
        "eslint/no-regex-spaces": "error",
        "eslint/no-restricted-exports": "error",
        "eslint/no-restricted-globals": "error",
        "eslint/no-restricted-imports": "error",
        "eslint/no-restricted-properties": "error",
        "eslint/no-return-assign": "error",
        "eslint/no-script-url": "error",
        "eslint/no-self-compare": "error",
        "eslint/no-sequences": "error",
        "eslint/no-unexpected-multiline": "error",
        "eslint/no-unneeded-ternary": "error",
        "eslint/no-unreachable-loop": "error",
        "eslint/no-useless-call": "error",
        "eslint/no-useless-computed-key": "error",
        "eslint/no-useless-concat": "error",
        "eslint/no-useless-constructor": "error",
        "eslint/no-var": "error",
        "eslint/no-warning-comments": "error",
        "eslint/object-shorthand": "error",
        "eslint/operator-assignment": "error",
        "eslint/prefer-arrow-callback": "error",
        "eslint/prefer-exponentiation-operator": "error",
        "eslint/prefer-numeric-literals": "error",
        "eslint/prefer-object-has-own": "error",
        "eslint/prefer-promise-reject-errors": "error",
        "eslint/prefer-regex-literals": "error",
        "eslint/prefer-rest-params": "error",
        "eslint/prefer-spread": "error",
        "eslint/radix": "error",
        "eslint/symbol-description": "error",
        "eslint/unicode-bom": "error",
        "eslint/vars-on-top": "error",
        "eslint/yoda": "error",
        "oxc/approx-constant": "error",
        "oxc/misrefactored-assign-op": "error",
        "oxc/no-async-endpoint-handlers": "error",
        "oxc/no-barrel-file": "error",
        "oxc/no-const-enum": "error",
        "oxc/no-this-in-exported-function": "error",
        "typescript/adjacent-overload-signatures": "error",
        "typescript/ban-tslint-comment": "error",
        "typescript/ban-types": "error",
        "typescript/class-literal-property-style": "error",
        "typescript/consistent-generic-constructors": "error",
        "typescript/consistent-type-assertions": "error",
        "typescript/consistent-type-exports": "error",
        "typescript/no-confusing-non-null-assertion": "error",
        "typescript/no-empty-interface": "error",
        "typescript/no-empty-object-type": "error",
        "typescript/no-extraneous-class": "error",
        "typescript/no-generated-empty-object-type": "error",
        "typescript/no-inferrable-types": "error",
        "typescript/no-mixed-enums": "error",
        "typescript/no-namespace": "error",
